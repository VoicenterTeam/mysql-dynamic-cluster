{
  "compilerOptions": {
    "experimentalDecorators": false,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "target": "es6",
    "strict": false,
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "./dist",
    "declaration": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "**/*.spec.ts", "tests"],
  "include": ["src/**/*", "index.ts"]
}
